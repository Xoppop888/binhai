# Supabase Configuration
# Получите эти значения в Settings > API вашего Supabase проекта

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# ВАЖНО: Используйте Service Role Key, а не Anon Key!
# Service Role Key имеет полные права на запись в базу данных
# Никогда не публикуйте этот ключ в публичном репозитории!
