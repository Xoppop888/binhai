# Supabase Configuration (Frontend)
# Получите эти значения в Settings > API вашего Supabase проекта

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ВАЖНО: Используйте Anon Key (публичный ключ), а не Service Role Key!
# Anon Key безопасен для использования в браузере
# Service Role Key используйте только в парсере (scripts/.env)
